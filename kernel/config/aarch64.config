# AegisRescue Kernel Configuration — aarch64 (ARM64)
# Inherits x86_64 hardening, ARM64-specific additions

# ─── ARM64 전용 ───────────────────────────────────────────
CONFIG_ARM64=y
CONFIG_ARM64_PTR_AUTH=y
CONFIG_ARM64_BTI=y
CONFIG_ARM64_BTI_KERNEL=y
CONFIG_ARM64_MTE=y
CONFIG_ARM64_PAN=y
CONFIG_ARM64_SW_TTBR0_PAN=y
CONFIG_ARM64_EPAN=y
CONFIG_SHADOW_CALL_STACK=y
CONFIG_ARM64_PA_BITS=48
CONFIG_ARM64_VA_BITS=48

# ─── 공통 하드닝 (x86_64 설정 포함) ─────────────────────
CONFIG_INIT_STACK_ALL_ZERO=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_SECURITY=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_YAMA=y
CONFIG_IMA=y
CONFIG_EVM=y
CONFIG_MODULE_SIG_FORCE=y
CONFIG_SECCOMP=y
CONFIG_DM_VERITY=y
CONFIG_DM_CRYPT=y

# ─── 파일시스템 ───────────────────────────────────────────
CONFIG_NTFS3_FS=y
CONFIG_EXFAT_FS=y
CONFIG_EXT4_FS=y
CONFIG_BTRFS_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS=y

# ─── 하드웨어 ─────────────────────────────────────────────
CONFIG_TPM=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
