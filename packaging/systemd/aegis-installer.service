[Unit]
Description=AegisRescue Installer Wizard
Documentation=https://aegisrescue.io/docs/installer
After=network.target graphical.target
Wants=graphical.target
ConditionPathExists=!/var/lib/aegis/.installed

[Service]
Type=simple
ExecStart=/opt/aegis/bin/aegis-installer
Restart=on-failure
RestartSec=3
Environment=DISPLAY=:0
Environment=WAYLAND_DISPLAY=wayland-0
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aegis-installer

# 샌드박스 (설치 전이므로 최소 제약)
NoNewPrivileges=false
PrivateTmp=true

[Install]
WantedBy=graphical-session.target
