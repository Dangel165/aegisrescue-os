[Unit]
Description=AegisRescue Installer Wizard
Documentation=https://aegisrescue.io/docs/installer
After=display-manager.service
ConditionPathExists=!/var/lib/aegis/.installed
ConditionKernelCommandLine=!aegis.cli

[Service]
Type=simple
User=aegis
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/aegis/.Xauthority
ExecStartPre=/bin/sh -c '! pgrep -x aegis-installer >/dev/null 2>&1'
ExecStartPre=/bin/sleep 4
ExecStart=/opt/aegis/bin/aegis-installer
Restart=on-failure
RestartSec=3
StandardOutput=append:/tmp/aegis-installer.log
StandardError=append:/tmp/aegis-installer.log
SyslogIdentifier=aegis-installer

NoNewPrivileges=false
PrivateTmp=true

[Install]
WantedBy=graphical.target
