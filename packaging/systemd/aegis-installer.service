[Unit]
Description=AegisRescue Installer Wizard
Documentation=https://aegisrescue.io/docs/installer
After=display-manager.service
ConditionPathExists=!/var/lib/aegis/.installed

[Service]
Type=simple
User=aegis
Environment=DISPLAY=:0
ExecStart=/opt/aegis/bin/aegis-installer
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aegis-installer

NoNewPrivileges=false
PrivateTmp=true

[Install]
WantedBy=graphical.target
