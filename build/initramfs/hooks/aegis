#!/bin/sh
# initramfs-tools 훅 — AegisRescue 모드 초기화
# /etc/initramfs-tools/hooks/aegis 에 설치

PREREQ=""

prereqs() { echo "$PREREQ"; }

case "$1" in
    prereqs) prereqs; exit 0 ;;
esac

. /usr/share/initramfs-tools/hook-functions

# aegis 커맨드라인 파서 스크립트를 initramfs에 포함
copy_exec /opt/aegis/bin/aegis-preflight /bin 2>/dev/null || true

# nftables 바이너리
copy_exec /sbin/nft /sbin 2>/dev/null || true
copy_exec /sbin/nftables /sbin 2>/dev/null || true

# 커널 모듈 — live ISO 마운트 + squashfs 루트
manual_add_modules iso9660 isofs udf loop squashfs overlay
manual_add_modules dm-verity dm-integrity
manual_add_modules aes-x86_64 sha256 sha512
manual_add_modules ntfs3 exfat vfat

manual_add_modules vmwgfx drm_kms_helper drm fb

# Plymouth boot splash theme (early boot logo)
if [ -f /etc/plymouth/plymouthd.conf ]; then
    mkdir -p "$DESTDIR/etc/plymouth"
    cp /etc/plymouth/plymouthd.conf "$DESTDIR/etc/plymouth/" 2>/dev/null || true
fi
if [ -d /usr/share/plymouth/themes/aegisrescue ]; then
    mkdir -p "$DESTDIR/usr/share/plymouth/themes/aegisrescue"
    cp -a /usr/share/plymouth/themes/aegisrescue/. "$DESTDIR/usr/share/plymouth/themes/aegisrescue/" 2>/dev/null || true
fi
if [ -f /etc/alternatives/default.plymouth ]; then
    target="$(readlink -f /etc/alternatives/default.plymouth 2>/dev/null || true)"
    if [ -n "$target" ] && [ -d "$(dirname "$target")" ]; then
        theme_dir="$(dirname "$target")"
        theme_name="$(basename "$theme_dir")"
        mkdir -p "$DESTDIR/usr/share/plymouth/themes/${theme_name}"
        cp -a "${theme_dir}/." "$DESTDIR/usr/share/plymouth/themes/${theme_name}/" 2>/dev/null || true
    fi
fi
