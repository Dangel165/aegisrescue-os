Window.SetBackgroundTopColor(0.0, 0.0, 0.0);
Window.SetBackgroundBottomColor(0.0, 0.0, 0.0);

# logo.png = source art; scaled to ~15% screen width (Windows boot splash style)
logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);

fun refresh_callback()
{
    screen_width = Window.GetWidth();
    screen_height = Window.GetHeight();
    target_w = screen_width * 0.15;

    logo.sprite.SetWidth(target_w);
    logo.sprite.SetHeight(-1);

    w = logo.sprite.GetWidth();
    h = logo.sprite.GetHeight();
    logo.sprite.SetX((screen_width - w) / 2);
    logo.sprite.SetY((screen_height - h) / 2);
    logo.sprite.SetZ(100);
}

refresh_callback();
Plymouth.SetRefreshFunction(refresh_callback);
